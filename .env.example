# Copy to .env and fill in locally. Never commit .env or real secret values.
# These names mirror config/config.toml.example [data_apis] and [broker.live] entries.

# Data API keys (Phase 6+ read-only adapters)
FRED_API_KEY=
DART_API_KEY=
FINNHUB_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# KIS live broker credentials (Phase 14+; paper mode does not require these)
KIS_LIVE_ACCOUNT=
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=

# Live trading confirmation phrase (required only when trading.mode = live)
LIVE_TRADING_CONFIRM=
