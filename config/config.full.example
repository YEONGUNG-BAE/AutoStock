# Forward-looking full configuration reference.
# NOT loaded by src/config/settings.py today — sections and keys may change as phases land.
# Use config/config.toml.example for the minimal loader-supported template.
# Copy to config/config.toml only after verifying each section is implemented in settings.py.
# Never commit real broker credentials, API keys, tokens, or account numbers.

[trading]
mode = "paper"
allow_live_trading = false
live_confirmation_env_var = "LIVE_TRADING_CONFIRM"
live_confirmation_phrase = "ENABLE_LIVE_TRADING"
initial_paper_cash_krw = 30000000

[llm]
provider = "ollama"
model = "qwen3.6:35b-a3b"
host = "http://localhost:11434"
temperature = 0.0
seed = 42
keep_alive = "24h"
default_num_ctx = 4096
default_think = false
timeout_seconds = 120
retry_count = 0

[risk]
# Total-account basis.
cash_min_percent = 10
cash_max_percent = 30
invested_min_percent = 70
paper_observation_invested_min_percent = 50
invested_max_percent = 90
asset_min_percent = 15
asset_max_percent = 55
gold_normal_min_percent = 18
gold_normal_max_percent = 22
gold_exception_min_percent = 15
gold_exception_max_percent = 25
single_stock_cumulative_buy_cost_cap_percent = 5

[allocator]
analysis_tolerance_percent = 5

[slippage]
kr_tolerance_percent = 0.5
us_tolerance_percent = 0.2
emergency_bypass = true

[mdd]
level_1_drawdown_percent = -10
level_1_target_cash_percent = 50
level_2_drawdown_percent = -15
level_2_target_cash_percent = 80
level_3_drawdown_percent = -20
level_3_target_cash_percent = 95
stage_cooldown_hours = 4
same_stage_max_triggers_per_day = 1
halt_trading_after_level_3 = true

[gold_trading]
monthly_trade_soft_limit = 2
quarterly_trade_soft_limit = 4
micro_adjust_ignore_below_percent = 3
increase_max_percent = 5
decrease_max_percent = 2

[emergency_triggers]
stock_drop_percent = -3.0
index_crash_percent = -1.5
portfolio_loss_percent = -2.0
profit_run_levels_percent = [10, 15, 20]

[date_id_staleness]
# Aligns with domain.staleness.StalenessPolicy defaults when wired into settings loader.
price_max_age_hours = 24
flow_max_age_hours = 24
fx_max_age_hours = 24
news_max_age_hours = 168
disclosure_max_age_hours = 2160
macro_default_max_age_hours = 720

[korea_market]
exchange = "KRX"
timezone = "Asia/Seoul"

[us_market]
exchange = "NYSE"
timezone = "America/New_York"
analysis_slots_per_session = 4

[paths]
data_dir = "memory"
date_file = "memory/Date.md"
daily_summary_dir = "memory/daily"
debug_file = "memory/debug/Debug.md"
weekly_postmortem_dir = "memory/postmortem/weekly"
monthly_postmortem_dir = "memory/postmortem/monthly"

[broker]
adapter = "paper"

[broker.account_roles]
use_isa_for_kr_and_gold = true
use_cma_for_order_execution = false
kr_tax_advantaged_account_env = "KIS_ISA_ACCOUNT"
us_regular_account_env = "KIS_US_REGULAR_ACCOUNT"
cash_buffer_account_env = "KIS_CMA_ACCOUNT"

[broker.paper]
name = "paper"
fill_model = "last_price"
kr_buy_slippage_bps = 10
kr_sell_slippage_bps = 10
us_buy_slippage_bps = 5
us_sell_slippage_bps = 5

[broker.live]
name = "kis_live"
endpoint = "https://openapi.koreainvestment.com:9443"
account_env = "KIS_LIVE_ACCOUNT"
app_key_env = "KIS_LIVE_APP_KEY"
app_secret_env = "KIS_LIVE_APP_SECRET"

[data_apis]
fred_api_key_env = "FRED_API_KEY"
dart_api_key_env = "DART_API_KEY"
finnhub_api_key_env = "FINNHUB_API_KEY"  # later phase (news)
naver_client_id_env = "NAVER_CLIENT_ID"  # later phase (news)
naver_client_secret_env = "NAVER_CLIENT_SECRET"  # later phase (news)
