# Minimal Phase 0 runtime configuration supported by src/config/settings.py today.
# Copy this file to config/config.toml and edit values there.
# Never commit real broker credentials, API keys, tokens, or account numbers.
# Config stores environment variable names only — not secret values.
#
# Forward-looking sections (risk, allocator, paths, data_apis, etc.) are documented in
# config/config.full.example and are not loaded by the current typed settings loader.

[trading]
# Valid values: "paper", "live".
mode = "paper"

# Live trading requires BOTH mode = "live" and allow_live_trading = true.
# It also requires the LIVE_TRADING_CONFIRM environment variable.
allow_live_trading = false
live_confirmation_env_var = "LIVE_TRADING_CONFIRM"
live_confirmation_phrase = "ENABLE_LIVE_TRADING"

[llm]
provider = "ollama"
model = "qwen3.6:35b-a3b"
host = "http://localhost:11434"
temperature = 0.0
seed = 42
keep_alive = "24h"
default_num_ctx = 4096
default_think = false
timeout_seconds = 120
retry_count = 0

[broker]
# paper = internal PaperBrokerAdapter. kis_live = live KIS path after all gates pass.
adapter = "paper"

[broker.account_roles]
use_isa_for_kr_and_gold = true
use_cma_for_order_execution = false
kr_tax_advantaged_account_env = "KIS_ISA_ACCOUNT"
us_regular_account_env = "KIS_US_REGULAR_ACCOUNT"
cash_buffer_account_env = "KIS_CMA_ACCOUNT"

[broker.kis_read_only]
# Read-only smoke path only — not wired to scheduler or automatic order execution.
enabled = false
timeout_seconds = 10

[broker.live]
# Environment variable names only — set values in .env or your shell, not in Git.
account_env = "KIS_LIVE_ACCOUNT"
app_key_env = "KIS_LIVE_APP_KEY"
app_secret_env = "KIS_LIVE_APP_SECRET"
