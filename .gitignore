# macOS
.DS_Store
__MACOSX/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.uv-cache/
.uv-tools/

# Secrets / local environment (never commit real values)
.env
.env.*
!.env.example
# .gitignore에서 두 줄 제거:
#   !/src/logs/
#   !/src/logs/**
git rm --cached src/logs/__pycache__/__init__.cpython-311.pyc
git rm --cached src/logs/__pycache__/daily_summary.cpython-311.pyc
git rm --cached src/logs/__pycache__/debug_writer.cpython-311.pyc
git rm --cached src/logs/__pycache__/event_codes.cpython-311.pyc
git rm --cached src/logs/__pycache__/event_log.cpython-311.pyc
git rm --cached src/logs/__pycache__/factory.cpython-311.pyc
git rm --cached src/logs/__pycache__/models.cpython-311.pyc


# Runtime config (commit config/config.toml.example only)
config/config.toml
config/*.local.toml
!config/config.toml.example
!config/config.full.example

secrets/
*.pem
*.key
*.crt

# Runtime artifacts
memory/
/logs/
*.db
*.sqlite
*.sqlite3

# Runtime data directory at repository root only (not src/data/)
/data/
